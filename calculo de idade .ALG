Algoritmo "idade"
Var
   ano, nasc, idade : inteiro
Inicio
      escreva("em que ano estamos? ")
      leia(ano)
      escreva("em que ano você nasceu?")
      leia(nasc)
      idade <- ano - nasc
      escreval("em ", ano," voce tera ", idade," anos")
      
      se (idade >= 21) entao
                escreval("voce é maior de idade")
      fimSe
      


Fimalgoritmo